# systemd unit for ResumeForge (gunicorn). Copy to /etc/systemd/system/resumeforge.service
# and replace the placeholders, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now resumeforge
#
# The app reads its config from the project's .env directly (django-environ), so
# no EnvironmentFile is needed. Pick a PORT not used by your other apps.
[Unit]
Description=ResumeForge (gunicorn)
After=network.target

[Service]
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/apps/ResumeForge
Environment=GUNICORN_BIND=127.0.0.1:8001
ExecStart=/home/YOUR_USER/apps/ResumeForge/.venv/bin/gunicorn resumeforge.wsgi:application -c gunicorn.conf.py
Restart=always
RestartSec=3
# PDF export launches Chromium; give it room.
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
