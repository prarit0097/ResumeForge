# Copy to .env and fill in. The app works WITHOUT any of these (AI runs in demo mode).
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Production only: your domain(s), comma-separated, with scheme. e.g.
# CSRF_TRUSTED_ORIGINS=https://resume.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# --- AI (OpenRouter -> DeepSeek). Leave OPENROUTER_API_KEY empty for offline demo mode. ---
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_FREE_MODEL=deepseek/deepseek-chat-v3-0324:free
# Set True to use the free (rate-limited) DeepSeek model.
USE_FREE_LLM=False

# --- Analytics / SEO (optional) ---
# Google Analytics 4 Measurement ID for traffic tracking, e.g. G-XXXXXXXXXX
GA_MEASUREMENT_ID=
# Public base URL (used for canonical + Open Graph tags), e.g. https://resume.yourdomain.com
SITE_URL=
